---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
	<h1>Penguins</h1>
      <PlotFigure
        options={{
          marks: [
            Plot.dot(penguins, {
				x: "culmen_length_mm",
				y: "culmen_profondeur_mm"})
          ]
        }}
      />
</Layout>
