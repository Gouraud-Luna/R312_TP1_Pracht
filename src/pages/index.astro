---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import pizza from "../assets/pizza.json";
import weather from "../assets/weather.json";
import olympians from "../assets/olympians.json";
---

<Layout>
    <header class="mb-8">
      <p class="p-4 mb-3 text-xl font-bold uppercase text-cyan-700">Data visualisation</p>
  
    </header>

    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-xl">    
      <h2 class="mb-4 text-xl font-semibold text-slate-800">Mesure de nageoir</h2>
      <div>
        <PlotFigure
          options={{
            marks: [
              Plot.dot(penguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
              })
            ]
          }}
        />
      </div>
	  <h2 class="mb-4 text-xl font-semibold text-slate-800">Pizza</h2>
      <div>
        <PlotFigure
          options={{
            marks: [
              Plot.dot(pizza, {
                x: "price",
                y: "order",
              })
            ]
          }}
        />
      </div>
	  <h2 class="mb-4 text-xl font-semibold text-slate-800">Weather</h2>
      <div>
        <PlotFigure
          options={{
            marks: [
              Plot.dot(weather,{
                x: "temp_max",
                y: "temp_min",
              })
            ]
          }}
        />
      </div>
	  <h2 class="mb-4 text-xl font-semibold text-slate-800">Olympians</h2>
      <div>
        <PlotFigure
          options={{
            marks: [
              Plot.dot(olympians,{
                x: "weight",
                y: "height",
              })
            ]
          }}
        />
      </div>
    </section>
</Layout>
