---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import pizza from "../assets/pizza.json";
---

<Layout>
    <header class="mb-8">
      <p class="p-4 mb-3 text-xl font-bold uppercase text-cyan-700">Data visualisation</p>
      <h1 class="px-5 mb-3 text-5xl font-bold leading-none text-slate-800">Penguins</h1>
    </header>

    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-xl">
      <h2 class="mb-4 text-xl font-semibold text-slate-800">Mesure de nageoir</h2>
      <div>
        <PlotFigure
          options={{
            marks: [
              Plot.dot(penguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
              })
            ]
          }}
        />
      </div>
    </section>
</Layout>
